{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/t",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/track"
    },
    {
      "source": "/start",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/start"
    },
    {
      "source": "/sign/:token",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/sign/:token"
    },
    {
      "source": "/kickoff/:token",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/kickoff/:token"
    },
    {
      "source": "/api/inbound-lead",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/inbound-lead"
    },
    {
      "source": "/api/sign",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/sign"
    },
    {
      "source": "/api/kickoff",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/kickoff"
    },
    {
      "source": "/api/workspace/public",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/workspace/public"
    },
    {
      "source": "/invoice/:token",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/invoice/:token"
    },
    {
      "source": "/api/invoice",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/invoice"
    },
    {
      "source": "/report/:token",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/report/:token"
    },
    {
      "source": "/api/report",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/report"
    },
    {
      "source": "/approve/:token",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/approve/:token"
    },
    {
      "source": "/api/approve",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/approve"
    },
    {
      "source": "/portal/:token",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/portal/:token"
    },
    {
      "source": "/api/portal",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/portal"
    },
    {
      "source": "/api/demo-reply",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/demo-reply"
    },
    {
      "source": "/testimonial/:token",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/testimonial/:token"
    },
    {
      "source": "/api/testimonial",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/testimonial"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/_next/:path*"
    },
    {
      "source": "/app",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/app"
    },
    {
      "source": "/app/:path*",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/app/:path*"
    },
    {
      "source": "/api/app/:path*",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/app/:path*"
    },
    {
      "source": "/app-sw.js",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/app-sw.js"
    },
    {
      "source": "/app.webmanifest",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/app.webmanifest"
    },
    {
      "source": "/app-icon-180.png",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/app-icon-180.png"
    },
    {
      "source": "/app-icon-192.png",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/app-icon-192.png"
    },
    {
      "source": "/app-icon-512.png",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/app-icon-512.png"
    },
    {
      "source": "/api/intake",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/intake"
    },
    {
      "source": "/api/client-calendar",
      "destination": "https://personal-command-center-ten-ruby.vercel.app/api/client-calendar"
    }
  ],
  "headers": [
    {
      "source": "/sign/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/kickoff/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/invoice/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/report/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/approve/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/portal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/testimonial/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "has": [
        {
          "type": "query",
          "key": "trade"
        }
      ],
      "destination": "/try",
      "permanent": false
    },
    {
      "source": "/fence",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pools",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fence-and-pool",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/fence-demo",
      "destination": "/demo",
      "permanent": false
    },
    {
      "source": "/pool-demo",
      "destination": "/demo",
      "permanent": false
    }
  ]
}
