# Copy to .env.local for local development and fill in real values.
# Never commit .env.local or any secret values.

DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Optional: enables the service-to-service, read-only Hermes brief endpoint.
# Generate a random secret of at least 32 characters.
HERMES_BRIDGE_TOKEN=
# The single Neon Auth user ID that the bridge may read.
HERMES_BRIDGE_OWNER_ID=
